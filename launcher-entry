#!/usr/bin/env python3
"""Rename an app, change its icon, or hide it from the launcher.

  launcher-entry scan                      JSON of the apps that can be changed
  launcher-entry set <id> name <text>      show it under another name
  launcher-entry set <id> icon <path>      use this image as its icon
  launcher-entry set <id> hidden <on|off>  keep it out of the launcher
  launcher-entry reset <id>                drop Lacquer's copy entirely

The packaged .desktop file in /usr/share is never touched. Changing an app
copies it to ~/.local/share/applications/, which is where the desktop looks
first, and edits the copy; reset deletes that copy and the packaged one takes
over again. A copy Lacquer did not write is left alone.
"""
import glob, json, os, re, shutil, sys

HOME = os.environ.get("HOME", "")
USER_DIR = os.path.join(HOME, ".local/share/applications")
SYSTEM_DIRS = ["/usr/share/applications", "/usr/local/share/applications",
               os.path.join(HOME, ".nix-profile/share/applications"),
               "/var/lib/flatpak/exports/share/applications",
               os.path.join(HOME, ".local/share/flatpak/exports/share/applications")]
MARKER = "X-Lacquer-Managed=true"
# Lacquer installs its own launcher entry with the same marker; it is not
# something the user changed, so it is not counted as one.
OWN = "lacquer.desktop"
ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$")
READ_LIMIT = 256 * 1024
MAX_ENTRIES = 2000


def read_capped(path):
    try:
        if not os.path.isfile(path) or os.path.getsize(path) > READ_LIMIT:
            return None
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(READ_LIMIT + 1)[:READ_LIMIT]
    except OSError:
        return None


def field(text, key):
    """The first value of a key in the [Desktop Entry] group."""
    group = text.split("\n[", 1)[0] if text.startswith("[Desktop Entry]") else text
    m = re.search(r"^%s\s*=\s*(.*)$" % re.escape(key), group, re.M)
    return m.group(1).strip() if m else ""


def entries():
    found = {}
    for folder in SYSTEM_DIRS:
        for path in sorted(glob.glob(os.path.join(folder, "*.desktop"))):
            name = os.path.basename(path)
            if name not in found:
                found[name] = {"id": name, "path": path, "mine": False}
    for path in sorted(glob.glob(os.path.join(USER_DIR, "*.desktop"))):
        name = os.path.basename(path)
        text = read_capped(path) or ""
        found[name] = {"id": name, "path": path, "mine": MARKER in text,
                       "userOnly": name not in found or found[name]["path"].startswith(USER_DIR)}
    return [found[k] for k in sorted(found)][:MAX_ENTRIES]


def describe(entry):
    text = read_capped(entry["path"]) or ""
    if field(text, "Type") not in ("Application", ""):
        return None
    return {
        "id": entry["id"],
        "name": field(text, "Name") or entry["id"].replace(".desktop", ""),
        "icon": field(text, "Icon"),
        "hidden": field(text, "NoDisplay").lower() == "true",
        "managed": entry.get("mine", False) and entry["id"] != OWN,
        "packaged": not entry["path"].startswith(USER_DIR),
    }


def scan():
    out = []
    for entry in entries():
        described = describe(entry)
        if described and described["name"]:
            out.append(described)
    print(json.dumps({"apps": out}))


def source_for(app_id):
    """The packaged file to copy from, or the user one if that is all there is."""
    for folder in SYSTEM_DIRS:
        candidate = os.path.join(folder, app_id)
        if os.path.isfile(candidate):
            return candidate
    candidate = os.path.join(USER_DIR, app_id)
    return candidate if os.path.isfile(candidate) else None


def set_key(text, key, value):
    """Set a key inside the [Desktop Entry] group, adding it if it is missing."""
    lines = text.split("\n")
    out = []
    in_entry = False
    done = False
    for line in lines:
        if line.startswith("["):
            if in_entry and not done:
                out.append("%s=%s" % (key, value))
                done = True
            in_entry = line.strip() == "[Desktop Entry]"
        elif in_entry and re.match(r"^%s\s*=" % re.escape(key), line):
            if done:
                continue
            line = "%s=%s" % (key, value)
            done = True
        out.append(line)
    if not done:
        # No group ended before the file did: append inside the last one.
        out.append("%s=%s" % (key, value))
    return "\n".join(out)


def change(app_id, what, value):
    if not ID.match(app_id) or not app_id.endswith(".desktop"):
        sys.exit("launcher-entry: not an app id: " + app_id)
    target = os.path.join(USER_DIR, app_id)
    text = read_capped(target)
    if text is None:
        source = source_for(app_id)
        if not source:
            sys.exit("launcher-entry: no such app: " + app_id)
        text = read_capped(source)
        if text is None:
            sys.exit("launcher-entry: cannot read " + source)
    elif MARKER not in text:
        sys.exit("launcher-entry: " + app_id + " already has your own copy; leaving it alone")

    if what == "name":
        value = re.sub(r"[\r\n]+", " ", value).strip()[:120]
        if not value:
            sys.exit("launcher-entry: an empty name would hide the app")
        text = set_key(text, "Name", value)
    elif what == "icon":
        path = os.path.realpath(value)
        if not os.path.isfile(path):
            sys.exit("launcher-entry: no such image: " + value)
        text = set_key(text, "Icon", path)
    elif what == "hidden":
        text = set_key(text, "NoDisplay", "true" if value == "on" else "false")
    else:
        sys.exit("launcher-entry: nothing called " + what)

    if MARKER not in text:
        text = set_key(text, MARKER.split("=")[0], "true")
    os.makedirs(USER_DIR, exist_ok=True)
    # Through a symlink rather than over it, in case the entry is one the user
    # keeps in a dotfile repository.
    real = os.path.realpath(target)
    tmp = real + ".lacquer-new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text if text.endswith("\n") else text + "\n")
    if os.path.exists(real):
        os.chmod(tmp, os.stat(real).st_mode & 0o777)
    os.replace(tmp, real)


def reset(app_id):
    if not ID.match(app_id) or not app_id.endswith(".desktop"):
        sys.exit("launcher-entry: not an app id: " + app_id)
    target = os.path.join(USER_DIR, app_id)
    text = read_capped(target)
    if text is None:
        return
    if MARKER not in text:
        sys.exit("launcher-entry: " + app_id + " is your own copy; leaving it alone")
    os.remove(target)


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit(__doc__)
    if argv[0] == "scan":
        scan()
    elif argv[0] == "set" and len(argv) == 4:
        change(argv[1], argv[2], argv[3])
    elif argv[0] == "reset" and len(argv) == 2:
        reset(argv[1])
    else:
        sys.exit(__doc__)


def _refused(err):
    """A readable line for a write the filesystem would not allow.

    A read-only ~/.config (home-manager and friends put one there), a file made
    immutable, or a full disk all arrive here as an OSError. The panel shows
    whatever comes back on stderr, and a Python traceback is no use to anybody.
    """
    home = os.environ.get("HOME", "")
    where = os.path.dirname(getattr(err, "filename", "") or "") or "that folder"
    return ("Could not write in %s: %s. Lacquer stopped there.\n"
            "A read-only folder, an immutable file or a full disk will do this."
            % (where.replace(home, "~") if home else where, err.strerror or err))


if __name__ == "__main__":
    try:
        main()
    except OSError as err:
        sys.exit(_refused(err))
